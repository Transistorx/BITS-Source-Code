# ---- Dispensing telemetry server configuration ----------------------------
# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# MySQL connection (used to build the SQLAlchemy URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dispense
DB_PASSWORD=change-me
DB_NAME=dispense_telemetry

# Expire unexecuted manual START/RESUME/CLEAR intent after this many seconds.
# STOP/CANCEL/E-STOP never expire. Live state requires one Uvicorn worker.
TRANSIENT_COMMAND_TTL_SECONDS=10

# Optional full override (wins over DB_* above).
# Production (MySQL):  mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4
# Tests (SQLite):      sqlite:///./test.db  or  sqlite://
# DATABASE_URL=

# Uvicorn bind address/port. 0.0.0.0 so ESP32 + LAN browsers can reach WSL.
HOST=0.0.0.0
PORT=8000

# Shared API key for telemetry WRITES (X-API-Key header). Empty = writes open.
# Must match WEIGHT_DEMO_TELEMETRY_API_KEY in the ESP32 firmware config.
API_KEY=

# Also require the key for dashboard READ endpoints (default: false)
READS_REQUIRE_KEY=false

# Comma-separated CORS origins. Leave empty: the dashboard is same-origin and
# the ESP32 does not send CORS preflights for simple JSON posts it makes.
# CORS_ORIGINS=http://192.168.1.50:8000

# MQTT bridge (Mosquitto, see ../docs/telemetry/mosquitto-setup.md). Default off.
MQTT_ENABLED=false
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Ranged PID profiles (CONTRACT 9.3). Per-pump max job target in grams; MIRRORS a firmware constant, keep equal.
PUMP1_MAX_TARGET_G=20000
PUMP2_MAX_TARGET_G=20000
# Keep emitting legacy PROFILE/PROFILE_CLEAR on activate/deactivate (schema-1 profiles only) until the firmware path is retired.
LEGACY_PROFILE_COMMANDS=1
